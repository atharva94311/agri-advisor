# Copy to .env and fill in.

# Mandi prices: free key from https://data.gov.in (sign up -> My Account -> API key)
MANDI_API_KEY=

# Your email, added to the User-Agent as OpenStreetMap Nominatim's usage policy asks
AGRI_CONTACT_EMAIL=

# Chat LLM via OpenRouter (https://openrouter.ai/keys). Empty LLM_PROVIDER = English template replies.
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o
LLM_API_KEY=

# Speech-to-text + text-to-speech in Indian languages: Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=

# Optional overrides (defaults shown)
# OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
# SOILGRIDS_REST_URL=https://rest.isric.org/soilgrids/v2.0
# SOILGRIDS_WCS_URL=https://maps.isric.org/mapserv
# AGRI_FORECAST_DAYS=16
# AGRI_CURVE_HORIZON_DAYS=90
# AGRI_READY_THRESHOLD=0.8
